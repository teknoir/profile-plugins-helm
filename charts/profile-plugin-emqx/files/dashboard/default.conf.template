# CSRF guard for the credentialed API (see the location below). The dashboard's own axios
# client sends "Authorization: Bearer <session token>" on every call (the placeholder
# "teknoir-istio", or a stale EMQX JWT that an owner's browser still has in localStorage from
# before the dashboard lost its login: any Bearer value is accepted, the proxy replaces it).
# An Authorization header makes a cross-origin request preflight (which fails, there is no
# CORS), so a foreign page cannot forge it. Reads need only a Bearer header; writes also need
# Sec-Fetch-Site same-origin, which browsers set and pages cannot change (same-site *.teknoir.cloud pages
# send "same-site" and are refused).
map $http_authorization $teknoir_bearer_ok {
    default 0;
    "~^Bearer .+" 1;
}
map "$teknoir_bearer_ok:$request_method:$http_sec_fetch_site" $teknoir_api_allowed {
    default 0;
    "~^1:(GET|HEAD):" 1;
    "~^1:[A-Z]+:same-origin$" 1;
}

# Audit line for the credentialed API. All dashboard calls reach EMQX as the one teamspace API
# key, so EMQX's own audit log cannot say who did what: this line carries the owner's email
# (X-Auth-Request-Email, set by the gateway's ext_authz, which the DENY policy makes the only
# way in) with the method and the PATH ($uri: no query string, so nothing a client puts in
# one is logged; never $request), the status and the request id of the gateway. It is written
# for every API write and for API calls that fail (status 4xx/5xx, e.g. a blocked CSRF
# attempt); successful reads are not logged. nginx escapes quotes and control characters in
# header values. API requests are never written by the default "main" log (its $request has
# the query string), see the access_log lines of the server.
log_format teknoir_audit 'AUDIT emqx.dashboard user="$http_x_auth_request_email" method=$request_method path="$uri" status=$status req_id="$http_x_request_id"';
map $request_uri $teknoir_is_api {
    default 0;
    "~^/api/v5/" 1;
}
map "$teknoir_is_api:$request_method:$status" $teknoir_audit {
    default 0;
    "~^1:(GET|HEAD|OPTIONS):[123]" 0;
    "~^1:" 1;
}
map $teknoir_is_api $teknoir_log_main {
    default 1;
    1 0;
}

server {
    listen 18083;
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 64m;
    add_header X-Frame-Options DENY always;
    # Server level: only requests that no location overrides (login, logout, users, api_key,
    # health). API requests go to the audit log, everything else to the usual "main" log.
    access_log /var/log/nginx/access.log teknoir_audit if=$teknoir_audit;
    access_log /var/log/nginx/access.log main if=$teknoir_log_main;

    location = /teknoir-healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
    location = /teknoir-sso.js { alias /teknoir/teknoir-sso.js; default_type application/javascript; add_header Cache-Control "no-store" always; }

    # The dashboard never logs in to EMQX: Istio decided who may be here.
    location = /api/v5/login  { default_type application/json; return 200 '{"token":"teknoir-istio","username":"teknoir","role":"administrator","version":"${EMQX_VERSION}","license":{"edition":"opensource"}}'; }
    location = /api/v5/logout { return 204; }
    location ^~ /api/v5/users   { default_type application/json; return 403 '{"code":"MANAGED_BY_TEKNOIR","message":"Dashboard users are not used: access is managed by Teknoir (teamspace owners)."}'; }
    location ^~ /api/v5/api_key { default_type application/json; return 403 '{"code":"MANAGED_BY_TEKNOIR","message":"API keys are managed by Teknoir."}'; }

    location ^~ /api/v5/ {
        # Explicit on purpose: a location with its own access_log does not inherit the server's,
        # so the "main" log (with query strings) can never also log these requests.
        access_log /var/log/nginx/access.log teknoir_audit if=$teknoir_audit;
        # Credentials only when the raw request path itself is /api/v5/...: a decoded or
        # dot-normalised path from another prefix (e.g. /events%2F..%2Fapi/v5/...) gets 400.
        if ($request_uri !~ "^/api/v5/") { return 400; }
        # Cross-site request forgery: the oauth2-proxy cookie is sent by browsers on any site,
        # so Istio alone does not prove the owner meant this call. 403, never 401 (see README).
        default_type application/json;
        if ($teknoir_api_allowed = 0) { return 403 '{"code":"TEKNOIR_CSRF_GUARD","message":"Blocked: the call did not come from the EMQX dashboard in this page (missing session header or cross-site request)."}'; }
        proxy_set_header Authorization "${EMQX_DASHBOARD_AUTH}";
        proxy_set_header Cookie "";
        proxy_set_header X-Auth-Request-Access-Token "";
        proxy_set_header X-Forwarded-Access-Token "";
        proxy_intercept_errors on;
        error_page 401 = @emqx_rejected;   # the gateway hangs on backend 401s (see README)
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_pass ${EMQX_DASHBOARD_UPSTREAM};
    }
    location @emqx_rejected { default_type application/json; return 403 '{"code":"EMQX_CREDENTIAL_REJECTED","message":"EMQX rejected the teamspace API key; see the emqx-dashboard pod."}'; }

    location / {
        # The index page changes with the EMQX version and with this proxy (teknoir-sso.js is
        # injected): a stale cached copy made owners see the login form. Revalidate every time.
        # add_header here replaces the server-level one, so X-Frame-Options is repeated.
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options DENY always;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Auth-Request-Access-Token "";
        proxy_set_header X-Forwarded-Access-Token "";
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '</body>' '<script src="teknoir-sso.js"></script></body>';
        proxy_http_version 1.1;
        proxy_pass ${EMQX_DASHBOARD_UPSTREAM};
    }
}
